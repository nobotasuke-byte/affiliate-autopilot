{
  "version": 1,
  "publication_mode": "manual_review",
  "require_source_url": true,
  "require_source_verified_at": true,
  "require_verified_primary_source_for": [
    "price",
    "fee",
    "reward",
    "campaign",
    "eligibility",
    "specification",
    "legal_or_tax_claim"
  ],
  "block_publication_when": [
    "missing_source",
    "unverified_price_or_terms",
    "broken_source_url",
    "affiliate_disclosure_missing",
    "asp_policy_unconfirmed"
  ],
  "require_affiliate_disclosure": true,
  "require_asp_terms_check": true,
  "allow_ai_only_fact_check": false,
  "allow_unreviewed_autopublish": false,
  "require_disclaimer_on_site_and_articles": true,
  "disclaimer_text": "当サイトに掲載される情報は、正確性・完全性を保証するものではなく、内容を利用することで生じた損害について、当サイト運営者は故意または重過失がある場合を除き責任を負いません。"
}
